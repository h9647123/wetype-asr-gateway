# Separate LAN administration entry. Replace 127.0.0.1 with your exact LAN IP
# only after setting allowed_console_origins and restricting your firewall.
server {
    listen 127.0.0.1:8080;
    server_name _;
    allow 127.0.0.1;
    deny all;
    client_max_body_size 30m;
    location = / { return 302 /console; }
    location = /console-login { access_log off; proxy_pass http://127.0.0.1:18080; proxy_set_header Host $http_host; }
    location / {
        proxy_pass http://127.0.0.1:18080;
        proxy_set_header Host $http_host;
        proxy_read_timeout 240s;
    }
}

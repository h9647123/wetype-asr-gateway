@@ -0,0 +1,215 @@
+"""Transport and native-session tests; no process injection or microphone use."""
+import os
+import struct
+import threading
+import unittest
+from unittest.mock import MagicMock, patch
+
+from fastapi.testclient import TestClient
+from starlette.websockets import WebSocketDisconnect
+
+import server
+from backend import BackendError
+from wetype_backend import WetypeBackend, WetypeTranscription
+from wetype_protocol import blob, integer, fields, value
+from wetype_stream import WetypeStream, HEADER, MAX_PCM_BYTES
+
+
+def answer(owner, text, final=False):
+    return {'code': 0, 'data': list(blob(1, blob(1, integer(1, 0)) + blob(2, owner.encode())
+        + blob(4, text.encode()) + integer(5, int(final))))}
+
+
+class NativeStreamTests(unittest.TestCase):
+    def setUp(self):
+        self.backend = WetypeBackend()
+        self.script = MagicMock()
+        self.session = MagicMock(is_detached=False)
+        self.backend._ensure_agent = MagicMock(return_value=self.script)
+        self.backend._session = self.session
+        self.backend._pid = 123
+        self.script.exports_sync.finalize.return_value = {'cleaned': True}
+        self.stream = WetypeStream(self.backend)
+        self.encoder_calls = 0
+
+        def encode(owner, pcm):
+            self.encoder_calls += 1
+            prefix = HEADER if self.encoder_calls == 1 else b''
+            return list(prefix + (struct.pack('<H', 1) + b'a') * (len(pcm) // 640))
+
+        def submit(data, owner):
+            inner = fields(value(fields(bytes(data)), 1, 2, None))
+            final = bool(value(inner, 6, 0, 0))
+            return answer(owner, '完整结果' if final else '中间文字', final)
+
+        self.script.exports_sync.stream_push.side_effect = encode
+        self.script.exports_sync.request.side_effect = submit
+
+    def test_persistent_encoder_padding_final_flag_and_cleanup(self):
+        with patch('wetype_stream.discover_pid', return_value=123):
+            self.stream.open()
+        first = self.stream.push(b'\0' * 16000)
+        self.assertEqual(first[0]['text'], '中间文字')
+        self.assertFalse(first[0]['final'])
+        self.assertEqual(self.stream.push(b'\0' * 2), [])
+        final = self.stream.finish()
+        self.assertTrue(final[-1]['final'])
+        self.assertEqual(final[-1]['text'], '完整结果')
+        self.stream.close()
+        self.stream.close()
+        self.script.exports_sync.stream_open.assert_called_once()
+        self.script.exports_sync.stream_close.assert_called_once()
+        self.assertEqual(self.backend._active_requests, 0)
+        self.assertEqual(self.encoder_calls, 2)
+
+    def test_over_limit_does_not_encode_or_mutate_count(self):
+        self.stream.pcm_bytes = MAX_PCM_BYTES
+        with self.assertRaises(BackendError) as result:
+            self.stream.push(b'\0\0')
+        self.assertEqual(result.exception.code, 'audio_too_long')
+        self.script.exports_sync.stream_push.assert_not_called()
+
+    def test_cleanup_uncertain_quarantines_backend(self):
+        with patch('wetype_stream.discover_pid', return_value=123):
+            self.stream.open()
+        self.script.exports_sync.finalize.return_value = {'cleaned': False}
+        with self.assertRaises(BackendError):
+            self.stream.close()
+        self.assertFalse(self.backend.healthy)
+        self.assertEqual(self.backend._active_requests, 0)
+        self.script.unload.assert_not_called()
+        self.session.detach.assert_not_called()
+
+    def test_premature_native_end_flag_rejected(self):
+        with patch('wetype_stream.discover_pid', return_value=123):
+            self.stream.open()
+        self.script.exports_sync.request.side_effect = lambda data, owner: answer(owner, '截断', True)
+        with self.assertRaises(BackendError) as result:
+            self.stream.push(b'\0' * 16000)
+        self.assertEqual(result.exception.code, 'premature_completion')
+        self.stream.close()
+
+    def test_cancel_prevents_another_native_submit_and_still_cleans(self):
+        with patch('wetype_stream.discover_pid', return_value=123):
+            self.stream.open()
+        self.stream.push(b'\0' * 16000)
+        before = self.script.exports_sync.request.call_count
+        self.stream.cancel()
+        with self.assertRaises(BackendError) as result:
+            self.stream.finish()
+        self.assertEqual(result.exception.code, 'request_cancelled')
+        self.assertEqual(self.script.exports_sync.request.call_count, before)
+        self.stream.close()
+
+    def test_ack_without_end_flag_does_not_finish(self):
+        with patch('wetype_stream.discover_pid', return_value=123):
+            self.stream.open()
+        self.stream.push(b'\0' * 16000)
+        self.script.exports_sync.request.return_value = answer(self.stream.owner, '稳定但未确认')
+        self.script.exports_sync.request.side_effect = None
+        with patch('wetype_stream.time.monotonic', side_effect=[10, 11, 60]), patch('wetype_stream.time.sleep'):
+            with self.assertRaises(BackendError) as result:
+                self.stream.finish()
+        self.assertEqual(result.exception.code, 'recognition_timeout')
+        self.assertFalse(self.stream.finished)
+        self.stream.close()
+
+
+class WebSocketTests(unittest.TestCase):
+    def setUp(self):
+        server.configure_backend('wetype')
+        self.client = TestClient(server.app)
+        self.client.__enter__()
+        self.native = MagicMock()
+        self.native.push.return_value = [{'type': 'snapshot', 'revision': 1, 'text': '测试', 'final': False}]
+        self.native.finish.return_value = [{'type': 'snapshot', 'revision': 2, 'text': '测试完成', 'final': True}]
+        self.patch = patch('wetype_stream.WetypeStream', return_value=self.native)
+        self.patch.start()
+        self.env = patch.dict(os.environ, {'WECHAT_API_KEY': 'fixture-test-key'})
+        self.env.start()
+
+    def tearDown(self):
+        self.client.__exit__(None, None, None)
+        self.patch.stop()
+        self.env.stop()
+        server.configure_backend('all')
+
+    def connect(self):
+        return self.client.websocket_connect('/v1/audio/stream', headers={'authorization': 'Bearer fixture-test-key'})
+
+    def test_auth_rejects_missing_key_without_opening_encoder(self):
+        with self.assertRaises(WebSocketDisconnect):
+            with self.client.websocket_connect('/v1/audio/stream'):
+                pass
+        self.native.open.assert_not_called()
+
+    def test_partial_before_end_and_final_after_cleanup(self):
+        with self.connect() as ws:
+            self.assertEqual(ws.receive_json()['type'], 'ready')
+            ws.send_bytes(b'\0' * 16000)
+            self.assertFalse(ws.receive_json()['final'])
+            ws.send_json({'type': 'end'})
+            self.assertTrue(ws.receive_json()['final'])
+            self.assertTrue(self.native.close.called)
+        self.native.open.assert_called_once()
+
+    def test_invalid_pcm_then_next_request_can_enter(self):
+        with self.connect() as ws:
+            ws.receive_json()
+            ws.send_bytes(b'x')
+            self.assertEqual(ws.receive_json()['code'], 'invalid_audio')
+        with self.connect() as ws:
+            self.assertEqual(ws.receive_json()['type'], 'ready')
+            ws.send_json({'type': 'cancel'})
+
+    def test_competing_stream_refused_before_encoder_open(self):
+        with self.connect() as first:
+            first.receive_json()
+            with self.connect() as second:
+                self.assertEqual(second.receive_json()['code'], 'backend_busy')
+            self.native.open.assert_called_once()
+            first.send_json({'type': 'cancel'})
+
+    def test_http_cannot_steal_live_stream_backend(self):
+        called = threading.Event()
+        completed = threading.Event()
+        replies = []
+        def transcribe(data):
+            called.set()
+            return WetypeTranscription('HTTP结果', 1, 123, 50, 100, 'server_end_flag')
+        def post():
+            replies.append(self.client.post('/v1/audio/transcriptions',
+                headers={'authorization': 'Bearer fixture-test-key'}, data={'model': 'wetype-voice'},
+                files={'file': ('fixture.wav', b'fixture')}))
+            completed.set()
+        with patch.object(server.backend, 'transcribe', side_effect=transcribe):
+            with self.connect() as ws:
+                ws.receive_json()
+                thread = threading.Thread(target=post, daemon=True)
+                thread.start()
+                self.assertFalse(called.wait(0.15))
+                ws.send_json({'type': 'cancel'})
+            self.assertTrue(completed.wait(3))
+            thread.join(1)
+        self.assertEqual(replies[0].status_code, 200)
+
+    def test_cancel_after_end_stops_final_polling(self):
+        started, cancelled, stopped = threading.Event(), threading.Event(), threading.Event()
+        def finish():
+            started.set()
+            if not cancelled.wait(2):
+                raise AssertionError('end must keep monitoring cancel')
+            stopped.set()
+            raise BackendError('识别已取消。', 400, 'request_cancelled')
+        self.native.finish.side_effect = finish
+        self.native.cancel.side_effect = cancelled.set
+        with self.connect() as ws:
+            ws.receive_json()
+            ws.send_json({'type': 'end'})
+            self.assertTrue(started.wait(1))
+            ws.send_json({'type': 'cancel'})
+            self.assertTrue(stopped.wait(1))
+
+
+if __name__ == '__main__':
+    unittest.main()

--- /dev/null
+++ b/wetype_stream.py
@@ -0,0 +1,176 @@
+"""Bounded, persistent WeType PCM session. Native calls remain synchronous.
+
+The ASGI adapter supplies backpressure and runs each call off the event loop.
+One owner survives from encoder creation through the explicit server end flag.
+"""
+import os
+import struct
+import time
+import threading
+import uuid
+
+from backend import BackendError
+from diagnostics import exception_detail
+from wetype_backend import discover_pid
+from wetype_protocol import ProtocolError, request, response
+
+MAX_PCM_BYTES = 60 * 32000
+BATCH_BYTES = 16000  # 500 ms; longer than the native 250 ms callback guard.
+HEADER = b'#!OPUS_RAW_V1\x02\x01\x00'
+
+
+class WetypeStream:
+    def __init__(self, backend):
+        self.backend = backend
+        self.owner = 'wt-stream-' + uuid.uuid4().hex
+        self.script = self.session = None
+        self.registered = self.encoder_open = False
+        self.sequence = self.encoded_bytes = self.pcm_bytes = self.revision = 0
+        self.buffer = bytearray()
+        self.text = ''
+        self.started = time.monotonic()
+        self.finished = False
+        self.cancelled = threading.Event()
+
+    def cancel(self):
+        # Setting a flag never frees native callbacks owned by an in-flight RPC.
+        self.cancelled.set()
+
+    def open(self):
+        backend = self.backend
+        with backend.lock:
+            pid = backend._pid if backend.agent_connected and not os.environ.get('WETYPE_PID') else discover_pid()
+            if backend._closing:
+                raise BackendError('服务正在停止。', 503, 'server_stopping')
+            if backend._active_requests:
+                raise BackendError('输入法识别服务忙。', 503, 'backend_busy')
+            if backend._unsafe_pid is not None and pid != backend._unsafe_pid:
+                backend._unsafe_pid = None
+                backend.healthy = True
+            if pid == backend._unsafe_pid or not backend.healthy:
+                raise BackendError('输入法原生回调尚未清理。', 503, 'cleanup_failed')
+            self.script = backend._ensure_agent(pid)
+            self.session = backend._session
+            backend._active_requests += 1
+            self.registered = True
+        self.script.exports_sync.stream_open(self.owner)
+        self.encoder_open = True
+
+    def _submit(self, audio, sequence, end=False):
+        if self.cancelled.is_set():
+            raise BackendError('识别已取消。', 400, 'request_cancelled')
+        if time.monotonic() - self.started > 150:
+            raise BackendError('流式识别超过总时限。', 504, 'recognition_timeout')
+        payload = request(self.owner, audio, sequence, self.encoded_bytes, end=end)
+        reply = self.script.exports_sync.request(list(payload), self.owner)
+        if self.cancelled.is_set():
+            raise BackendError('识别已取消。', 400, 'request_cancelled')
+        if reply['code'] != 0:
+            raise BackendError('输入法语音网络请求失败。', 502, 'wetype_transport_error',
+                               details={'native_code': reply['code'], 'task_id': reply.get('taskId')})
+        return response(bytes(reply['data']), self.owner)
+
+    def _encode_submit(self, pcm):
+        encoded = bytes(self.script.exports_sync.stream_push(self.owner, list(pcm)))
+        offset = 16 if self.sequence == 0 else 0
+        if self.sequence == 0 and not encoded.startswith(HEADER):
+            raise ProtocolError('持续编码缺少首片流头。')
+        if self.sequence and encoded.startswith(HEADER):
+            raise ProtocolError('持续编码意外重置。')
+        frames = 0
+        while offset < len(encoded):
+            if offset + 2 > len(encoded):
+                raise ProtocolError('持续编码帧长度不完整。')
+            size = struct.unpack_from('<H', encoded, offset)[0]
+            offset += size + 2
+            if not 0 < size <= 1500 or offset > len(encoded):
+                raise ProtocolError('持续编码帧不完整。')
+            frames += 1
+        if frames != len(pcm) // 640:
+            raise ProtocolError('持续编码帧数与 PCM 不一致。')
+        self.sequence += 1
+        self.encoded_bytes += len(encoded)
+        current = self._submit(encoded, self.sequence)
+        if current.end_flag:
+            raise BackendError('输入法在音频结束前提前关闭识别，未交付可能截断的文字。',
+                               502, 'premature_completion')
+        return current
+
+    def _snapshot(self, current, *, final=False):
+        # Empty ACKs are not text erasures. Final text remains authoritative.
+        if not final and (not current.text or current.text == self.text):
+            return None
+        self.text = current.text
+        self.revision += 1
+        return {'type': 'snapshot', 'revision': self.revision, 'text': self.text, 'final': final}
+
+    def push(self, pcm):
+        if self.finished or not pcm or len(pcm) % 2:
+            raise BackendError('PCM 必须为非空 s16le 数据。', 400, 'invalid_audio')
+        if self.pcm_bytes + len(pcm) > MAX_PCM_BYTES:
+            raise BackendError('音频（含尾音）不能超过 60 秒。', 413, 'audio_too_long')
+        self.pcm_bytes += len(pcm)
+        self.buffer.extend(pcm)
+        results = []
+        while len(self.buffer) >= BATCH_BYTES:
+            batch = bytes(self.buffer[:BATCH_BYTES])
+            del self.buffer[:BATCH_BYTES]
+            item = self._snapshot(self._encode_submit(batch))
+            if item:
+                results.append(item)
+        return results
+
+    def finish(self):
+        if self.finished or not self.pcm_bytes:
+            raise BackendError('没有可识别的音频。', 400, 'empty_audio')
+        results = []
+        if self.buffer:
+            self.buffer.extend(b'\0' * (-len(self.buffer) % 640))
+            item = self._snapshot(self._encode_submit(bytes(self.buffer)))
+            self.buffer.clear()
+            if item:
+                results.append(item)
+        self.sequence += 1
+        deadline = time.monotonic() + 40
+        current = self._submit(b'', self.sequence, True)
+        while not current.end_flag:
+            item = self._snapshot(current)
+            if item:
+                # The caller is waiting on finalization. Retain only the last
+                # intermediate snapshot instead of growing a full-text list.
+                results[:] = [item]
+            if time.monotonic() >= deadline:
+                raise BackendError('输入法未确认识别结束。', 504, 'recognition_timeout')
+            if self.cancelled.wait(max(0.1, min(current.interval_ms / 1000, 1))):
+                raise BackendError('识别已取消。', 400, 'request_cancelled')
+            current = self._submit(b'', 0, True)
+        self.finished = True
+        results.append(self._snapshot(current, final=True))
+        with self.backend.lock:
+            self.backend.last_success = time.time()
+            self.backend.last_completion = 'server_end_flag'
+            self.backend.last_error = self.backend.last_error_detail = None
+        return results
+
+    def close(self):
+        if not self.registered:
+            return
+        cleanup = {'cleaned': bool(self.session.is_detached)}
+        try:
+            if not self.session.is_detached:
+                if self.encoder_open:
+                    self.script.exports_sync.stream_close(self.owner)
+                    self.encoder_open = False
+                cleanup = self.script.exports_sync.finalize(self.owner)
+        except Exception as error:
+            cleanup = {'cleaned': bool(self.session.is_detached), 'error': exception_detail(error)}
+        finally:
+            with self.backend.lock:
+                if not cleanup.get('cleaned'):
+                    self.backend.healthy = False
+                    self.backend.last_error = 'cleanup_failed'
+                self.backend._active_requests -= 1
+                self.backend.lock.notify_all()
+                self.registered = False
+        if not cleanup.get('cleaned'):
+            raise BackendError('原生回调未清理，已暂停后续调用。', 503, 'cleanup_failed')

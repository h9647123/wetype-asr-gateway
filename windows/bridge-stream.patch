+class WetypeAdmission:
+    """Preserve HTTP concurrency; a live encoder needs exclusive ownership."""
+    def __init__(self):
+        self.condition = anyio.Condition()
+        self.http_active = 0
+        self.stream_active = False
+
+    @asynccontextmanager
+    async def http(self):
+        async with self.condition:
+            while self.stream_active:
+                await self.condition.wait()
+            self.http_active += 1
+        try:
+            yield
+        finally:
+            with anyio.CancelScope(shield=True):
+                async with self.condition:
+                    self.http_active -= 1
+                    self.condition.notify_all()
+
+    def try_stream(self):
+        # ASGI handlers run on one event loop. No await between check and set.
+        if self.http_active or self.stream_active:
+            raise anyio.WouldBlock
+        self.stream_active = True
+
+    async def release_stream(self):
+        with anyio.CancelScope(shield=True):
+            async with self.condition:
+                self.stream_active = False
+                self.condition.notify_all()
+
+
